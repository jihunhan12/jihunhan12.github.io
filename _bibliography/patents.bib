@patent{ryuMethodSystemControlling2014a,
  title = {Method and System for Controlling Power of a Fuel Cell Vehicle},
  author = {RYU, Seongpil and Kwon, Sang Uk and Lee, Kyuil and Choi, Seo Ho and HAN, Jihun and Park, Youngjin},
  year = 2014,
  month = sep,
  number = {DE102013220480A1},
  urldate = {2026-08-06},
  abstract = {Ein Verfahren zum Steuern/Regeln von Leistung eines Brennstoffzellenfahrzeugs umfasst ein Unterteilen einer erwarteten Fahrstrecke des Brennstoffzellenfahrzeugs in eine Mehrzahl von Abschnitten und ein Einstellen der Mehrzahl von Abschnitten gem\"a\ss{} einem Gradienten; und ein Vergleichen, ob sich eine vorhergesagte Ladezustands\"anderung der Batterie innerhalb eines Batterielade/-entlade-Toleranzbereichs f\"ur jeden von der Mehrzahl von unterteilten Abschnitten befindet. Das Verfahren umfasst ferner ein Vergleichen einer vorhergesagten Leistung mit einer vorgegebenen maximalen Leistungsvorgabe f\"ur jeden von der Mehrzahl von unterteilten Abschnitten und ein Einstellen der Mehrzahl von unterteilten Abschnitten im Voraus als einen Batterielade/-entlade-Unterbindungsabschnitt und einen Batterielade/-entlade-Bewilligungsabschnitt gem\"a\ss{} einem Ergebnis des Vergleichs der vorhergesagten Ladezustands\"anderung der Batterie und der vorhergesagten Leistung.A method of controlling power of a fuel cell vehicle includes dividing an expected travel distance of the fuel cell vehicle into a plurality of sections and setting the plurality of sections according to a gradient; and comparing whether a predicted battery state of charge change is within a battery charge / discharge tolerance range for each of the plurality of divided sections. The method further includes comparing a predicted performance with a predetermined maximum performance for each of the plurality of divided sections and setting the plurality of divided sections in advance as a battery charging / discharging prohibition section and a battery charging / discharging permission section according to one Result of the comparison of the predicted change in the state of charge of the battery and the predicted power.},
  assignee = {Hyundai Motor Co, Korea Advanced Institute of Science and Technology KAIST},
  nationality = {DE},
  keywords = {battery,charge,discharge,predicted,sections},
  file = {C:\Users\jihun\Zotero\storage\F4L92XCC\RYU et al. - 2014 - Method and system for controlling power of a fuel cell vehicle.pdf}
}

