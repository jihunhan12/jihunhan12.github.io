@patent{leon-ojedaMETHODDETERMININGSPEED2019,
  title = {{{METHOD FOR DETERMINING A SPEED TO BE REACHED FOR A FIRST VEHICLE PRECEDED BY A SECOND VEHICLE}}, {{ESPECIALLY FOR AN AUTONOMOUS VEHICLE}}},
  author = {{Leon-Ojeda}, Luis and HAN, Jihun and Sciarretta, Antonio and Thibault, Laurent and NUNZIO, Giovanni DE},
  year = 2019,
  month = aug,
  number = {FR3070658B1},
  urldate = {2026-08-06},
  abstract = {La pr\'esente invention concerne un proc\'ed\'e de d\'etermination d'une vitesse optimale \`a atteindre pour un premier v\'ehicule pr\'ec\'ed\'e par un deuxi\`eme v\'ehicule. Pour ce proc\'ed\'e, on mesure (MES) la position, la vitesse et l'acc\'el\'eration du deuxi\`eme v\'ehicule pour en d\'eterminer sa trajectoire (POS), et on construit un mod\`ele dynamique (MOD) du premier v\'ehicule. Puis, on d\'etermine la vitesse \`a atteindre (VIT) par une minimisation (MIN) de l'\'energie consomm\'ee par le v\'ehicule au moyen du mod\`ele dynamique (MIN), la minimisation \'etant contrainte par la trajectoire (POS) du deuxi\`eme v\'ehicule.The present invention relates to a method for determining an optimum speed to be achieved for a first vehicle preceded by a second vehicle. For this method, the position, the speed and the acceleration of the second vehicle are measured (MES) to determine its trajectory (POS), and a dynamic model (MOD) of the first vehicle is constructed. Then, the speed to be achieved (VIT) is determined by minimizing (MIN) the energy consumed by the vehicle by means of the dynamic model (MIN), the minimization being constrained by the trajectory (POS) of the second vehicle.},
  assignee = {IFP Energies Nouvelles IFPEN},
  langid = {english},
  nationality = {FR},
  keywords = {determining,energy,optimum,speed,vehicle},
  file = {C:\Users\jihun\Zotero\storage\DMPE4L5S\Leon-Ojeda et al. - 2019 - METHOD FOR DETERMINING A SPEED TO BE REACHED FOR A FIRST VEHICLE PRECEDED BY A SECOND VEHICLE, ESPEC.pdf}
}

