---
layout: page
---
<div class="post">
  <article>
    {% if page.profiles %}
      
      {% assign sections = "prof,admin,researcher,postdoc,graduate,undergraduate,alumni" | split: "," %}
      {% for sec in sections %}    
        {% assign has_profiles_in_section = false %}
        {% for profile in page.profiles %}
          {% if profile.section == sec %}
            {% assign has_profiles_in_section = true %}
          {% endif %}
        {% endfor %}
        {% if has_profiles_in_section %}
          {% if sec == "prof" %}            
          {% elsif sec == "researcher" %}
            <h2>Researchers</h2>
          {% elsif sec == "admin" %}
            <h2>Admin Staff</h2>
          {% elsif sec == "postdoc" %}
            <h2>Postdocs</h2>
          {% elsif sec == "graduate" %}
            <h2>Graduate Students</h2>
          {% elsif sec == "undergraduate" %}
            <h2>Undergraduate Students</h2>
          {% endif %}

          {% for profile in page.profiles %}
            {% if profile.section == sec %}
              <hr>
              <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
                {% if profile.image %}
                  {% assign profile_image_path = profile.image | prepend: 'assets/img/labmember/' %}
                  {% if profile.image_circular %}
                    {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                  {% else %}
                    {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                  {% endif %}
                  {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
                  {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
                {% endif %}
                {% if profile.more_info %}
                  <div class="more-info">{{ profile.more_info }}</div>
                {% endif %}                     
              </div>

              <div class="clearfix">                
                {% if profile.content %}
                  {% capture profile_content %}{% include {{ profile.content }} %}{% endcapture %}
                  {{ profile_content | markdownify }}
                {% else %}
                  {{ content }}
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </article>
</div>
